{
  "listen": ":8082",
  "admin_key": "change-me-admin",
  "api_keys": [
    "sk-ctapi-change-me"
  ],
  "accounts_dir": "./data",
  "default_proxy_url": "",
  "proxies": [
    {
      "name": "us1",
      "url": "http://user:pass@us-proxy.example.com:8080",
      "timezone": "America/New_York",
      "language": "en-US,en;q=0.9"
    },
    {
      "name": "jp1",
      "url": "socks5://jp-proxy.example.com:1080",
      "timezone": "Asia/Tokyo",
      "language": "ja-JP,ja;q=0.9,en-US;q=0.8"
    }
  ],
  "profile": "2.1.247",
  "max_body_mb": 32,
  "mimicry": {
    "default_entrypoint": "cli",
    "redact_thinking": false,
    "dispatch_header": false,
    "disable_dateline_normalization": false,
    "max_attempts": 3,
    "telemetry_bypass": true
  }
}